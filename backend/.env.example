# ==============================================================================
# ODESolver Backend - Environment Configuration (.env.example)
# Copy to .env: cp .env.example .env
# ==============================================================================

# Server Port
PORT=5000

# JSON Web Token Secret Key
JWT_SECRET=supersecretkey123_replace_in_production

# MongoDB Connection String (Optional: leaves empty to use local JSON db.json fallback)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ode_solver?retryWrites=true&w=majority
